# HƯỚNG DẪN:
# Sao chép file này thành .env và điền giá trị thật.
# ⚠️ KHÔNG commit file .env lên GitHub để tránh lộ thông tin nhạy cảm.

# ─────────────────────────────────────────────
# Keycloak Admin (Tài khoản quản trị)
# ─────────────────────────────────────────────
# Dùng để đăng nhập vào trang admin console
# http://localhost:8080/admin
KC_ADMIN_USER=admin
KC_ADMIN_PASSWORD=your_admin_password_here


# ─────────────────────────────────────────────
# Database (PostgreSQL)
# ─────────────────────────────────────────────
# Keycloak sẽ dùng thông tin này để kết nối DB
DB_USER=keycloak
DB_PASSWORD=your_db_password_here


# ─────────────────────────────────────────────
# Keycloak Server (qua Load Balancer)
# ─────────────────────────────────────────────
# Cổng expose ra ngoài (Nginx)
KEYCLOAK_PORT=8080


# ─────────────────────────────────────────────
# Client App (OIDC Configuration)
# ─────────────────────────────────────────────

# Ví dụ: uit-keycloak-realm
KC_REALM=your_realm_name

# Ví dụ: myapp
KC_CLIENT_ID=your_client_id

# Lấy tại tab 'Credentials' trong Keycloak
KC_CLIENT_SECRET=your_client_secret

# Trỏ về Nginx (Load Balancer), KHÔNG gọi trực tiếp Keycloak node
# Trong Docker: http://nginx:8080
# Trên máy host (trình duyệt): http://localhost:8080
KC_SERVER_URL=http://localhost:8080


# ─────────────────────────────────────────────
# Ứng dụng Node.js
# ─────────────────────────────────────────────
APP_PORT=3000

# Chuỗi bất kỳ dùng để mã hóa session (nên đổi khi deploy thật)
SESSION_SECRET=your_session_secret


# ─────────────────────────────────────────────
# Social Login (Google / GitHub)
# ─────────────────────────────────────────────
# Điền sau khi tạo OAuth App

GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
